{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "traiding",
  "version": "0.2.0",
  "identifier": "dev.traiding.terminal",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ui",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "traiding",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "resources": {
      "binaries/alpaca": "bin/alpaca"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Finance",
    "shortDescription": "Alpaca trading terminal",
    "longDescription": "An Alpaca paper/live trading terminal in a single Rust binary: charting, positions, orders and an order ticket, with credentials held in the local process."
  }
}
