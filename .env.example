# Alpaca credentials (optional).
#
# A successful connect writes the key pair to the app-config .env so the app
# reconnects on its own. These variables still override it for scripted/dev
# launches; leave them unset to use the connect dialog.
#
# A key is only valid on its own host, and the prefix tells you which you have:
#   PK…  -> paper trading  (paper-api.alpaca.markets)
#   AK…  -> live trading   (api.alpaca.markets)
# Sending a key to the wrong host fails with a bare "unauthorized".
#
# Paper trading keys: https://app.alpaca.markets/paper/dashboard/overview
# Prefer the paper pair for development; it takes priority when both are set.
APCA_TEST_API_KEY_ID=
APCA_TEST_API_SECRET_KEY=

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional override. The endpoint is inferred from the key prefix, so this is
# only needed to force one. It must agree with the prefix, otherwise the startup
# login is skipped with a warning instead of sending a key that will be rejected.
# APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Assistant (optional, BYOK).
#
# The Agent tab streams through OpenRouter from the Rust process. The key is
# never sent to the webview or stored in SQLite; saving it writes the app-config
# .env (0600). Without it, the Agent tab shows a key form instead of a composer.
OPENROUTER_API_KEY=
# Model slug. Defaults to a free tool-capable model.
# AGENT_MODEL=inclusionai/ling-3.2-flash:free
# Hybrid-reasoning models stream thinking instead of content unless disabled.
# AGENT_REASONING=1

# Log verbosity (tracing EnvFilter syntax).
RUST_LOG=traiding=info
